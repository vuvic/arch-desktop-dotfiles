#!/usr/bin/env bash

# Get all official packages and store them in a text file.
pacman -Qqe > $HOME/dotfiles/packages/pkg-list.txt

# Repeat for all unofficial packages via AUR  in a separate text file.
pacman -Qme > $HOME/dotfiles/packages/pkg-list-aur.txt

echo 'Update successful. Updated package lists can be found in ~/dotfiles/packages.'

git -C $HOME/dotfiles add packages
git -C $HOME/dotfiles commit -m "Updated package lists via an automated script found /bin/.local/bin/"
git -C $HOME/dotfiles push origin main
